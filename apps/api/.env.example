# Spring Boot datasource. The defaults match compose.yaml.
NURIGO_DB_URL=jdbc:postgresql://localhost:5432/nurigo
NURIGO_DB_USERNAME=nurigo
NURIGO_DB_PASSWORD=nurigo

# Admin routes are disabled until a non-blank token is supplied.
NURIGO_ADMIN_TOKEN=replace-with-a-long-random-development-token

# Keep the API loopback-only unless a physical test device must connect.
NURIGO_SERVER_ADDRESS=127.0.0.1
NURIGO_SERVER_PORT=8080
